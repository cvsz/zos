# Single-network Wi-Fi profile (secret-free)
# EWS1200D/EWS310AP controller-side settings are applied manually in the controller.
WIFI_MODE=single-network
WIFI_SSID=CHANGE_ME
WIFI_NETWORK=192.168.1.0/24
WIFI_GATEWAY=192.168.1.1
WIFI_DHCP_SERVER=lan-dhcp
WIFI_LAN_BRIDGE=DBC-Bridge-Local
WIFI_CONTROLLER_IP=192.168.1.50
WIFI_AP_IPS=192.168.1.51,192.168.1.52,192.168.1.53,192.168.1.54,192.168.1.55,192.168.1.56,192.168.1.57,192.168.1.58

# One shared broadcast domain. Do not create a Wi-Fi VLAN for this profile.
WIFI_VLAN_MODE=untagged
WIFI_GUEST_NETWORK=0
WIFI_CAPTIVE_PORTAL=0
WIFI_CLIENT_ISOLATION=0

# EWS controller radio policy.
WIFI_BAND_STEERING=1
WIFI_FAST_ROAMING=1
WIFI_AUTO_CHANNEL=1
WIFI_AUTO_TX_POWER=1
WIFI_24GHZ_CHANNEL_WIDTH_MHZ=20
WIFI_5GHZ_CHANNEL_WIDTH_MHZ=40

# Never store the PSK in Git. Configure it only in EWS1200D.
WIFI_PSK_SET_IN_CONTROLLER_ONLY=1
