# zOS operator/developer environment example
#
# This file is NOT auto-loaded by zOS. It is a safe reference for shells,
# IDEs, containers, and local tooling. The authoritative topology file remains
# config/topology.env (created from config/topology.env.example).
#
# Never commit a populated .env file.

# Optional path override. Leave empty to use config/topology.env.
OMEGA_ENV_FILE=

# Production mutation gates: fail closed by default.
OMEGA_REQUIRE_DRY_RUN=1
OMEGA_DRY_RUN_MAX_AGE_SECONDS=3600
OMEGA_REQUIRE_SAFE_MODE=1
OMEGA_ALLOW_LIVE_APPLY=0

# RouterOS update automation.
ROUTEROS_UPDATE_CHANNEL=stable
ROUTEROS_UPDATE_NOTIFY_URL=
ROUTEROS_UPDATE_NOTIFY_TOKEN=
OMEGA_AUTO_ROUTEROS_UPDATE=0
OMEGA_ALLOW_ROUTER_REBOOT=0

# CORE network/SSH bootstrap overrides.
LAN_IFACE=ens33
WG_IFACE=policedbc
LAN_CIDR=192.168.1.0/24
GW=192.168.1.1
SSH_PORT=22
SSH_ALLOW_PASSWORD=no

# Leave blank to let core/install.sh derive the invoking sudo/user account.
SSH_USER=
