# zOS runtime/automation environment example
#
# This file is a reference and is not auto-loaded by zOS.
# Keep topology values in config/topology.env.

# Optional custom topology file. Empty uses the repository default.
OMEGA_ENV_FILE=

# Production change gates.
OMEGA_REQUIRE_DRY_RUN=1
OMEGA_DRY_RUN_MAX_AGE_SECONDS=3600
OMEGA_REQUIRE_SAFE_MODE=1
OMEGA_ALLOW_LIVE_APPLY=0

# RouterOS update policy.
ROUTEROS_UPDATE_CHANNEL=stable
ROUTEROS_UPDATE_NOTIFY_URL=
ROUTEROS_UPDATE_NOTIFY_TOKEN=
OMEGA_AUTO_ROUTEROS_UPDATE=0
OMEGA_ALLOW_ROUTER_REBOOT=0
